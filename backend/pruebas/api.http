@baseUrl = http://localhost:3000/api

@itemVictor = 1
@itemCamiloRojas = 3
@itemGrossman = 8
@anaCalculo = m1
@anaEscritorio = m2
@anaCalculadora = m3
@anaChaqueta = m4
@solicitudAceptadaDeAna = 2
@recibidaPendiente = rr1
@recibidaRechazada = rr2
@sara = u3
@catMuebles = c4
@catInstrumentos = c5

